{
  "name": "open-chatgpt-on-mac",
  "version": "0.1.0",
  "private": false,
  "description": "让 ChatGPT 网页版通过反向 SSH 隧道操作你的 Mac —— 不装客户端、不消耗 API 额度",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "hono": "^4.6.14",
    "ssh2": "^1.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ssh2": "^1.15.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhanglili31/open-chatgpt-on-mac.git"
  },
  "keywords": [
    "chatgpt",
    "gpt-actions",
    "mcp",
    "ssh",
    "reverse-tunnel",
    "macos",
    "remote-execution"
  ]
}
