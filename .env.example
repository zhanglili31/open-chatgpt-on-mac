# ── HTTP 服务 ────────────────────────────────────────────────
# 只监听回环，公网流量由 nginx 反代进来（见 deploy/nginx.conf）
HOST=127.0.0.1
PORT=8787

# ── 认证（必填）────────────────────────────────────────────
# ChatGPT 调用时放在 Authorization: Bearer <token>
# 生成：openssl rand -hex 32
API_TOKEN=

# ── SSH 目标：VPS 上由 MacBook 反向隧道打出来的本地端口 ──────
SSH_HOST=127.0.0.1
SSH_PORT=2222
SSH_USER=
# 二选一：私钥路径（推荐）或私钥内容
SSH_PRIVATE_KEY_PATH=/root/.ssh/id_bridge
SSH_PRIVATE_KEY=
SSH_PASSPHRASE=
# MacBook 主机公钥指纹校验（留空=不校验，强烈建议填）
# 取值：ssh-keyscan -p 2222 127.0.0.1 后对 ed25519 公钥算 sha256
SSH_HOST_FINGERPRINT=

# ── 执行限制 ─────────────────────────────────────────────────
# 单条命令默认 / 最大超时（毫秒）
DEFAULT_TIMEOUT_MS=60000
MAX_TIMEOUT_MS=900000
# stdout / stderr 各自最大回传字节数，超出截断
MAX_OUTPUT_BYTES=200000
# 同时在跑的 SSH 命令数上限
MAX_CONCURRENCY=4
# read_file 单文件最大字节数
MAX_READ_BYTES=5242880
# 危险命令确认令牌有效期（毫秒）
CONFIRM_TTL_MS=300000

# ── 日志 ─────────────────────────────────────────────────────
LOG_DIR=./logs
LOG_LEVEL=info
